{
  "name": "deepseek-harness-workspace",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.1-rc.2",
    "dsh-tui": "^0.2.19"
  },
  "trustedDependencies": [
    "@deepseek-ai/dsh-subprocess-local",
    "@google/genai",
    "koffi",
    "node-pty",
    "protobufjs"
  ],
  "scripts": {
    "web": "DSH_HOME=\"${DSH_HOME:-./.dsh}\" dsh web",
    "cli": "DSH_HOME=\"${DSH_HOME:-./.dsh}\" dsh-tui",
    "headless": "DSH_HOME=\"${DSH_HOME:-./.dsh}\" dsh --profile headless",
    "sync-models": "bun run sync-models.js",
    "doctor": "bun doctor.js",
    "reset": "bash reset.sh"
  }
}